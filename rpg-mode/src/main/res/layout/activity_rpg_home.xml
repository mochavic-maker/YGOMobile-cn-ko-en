<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <!-- Compact pinned top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/btn_rpg_back"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="返回"
            android:textColor="#E2E8F0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="OCG RPG 编年史模式"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_rpg_tokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="代币: 1200"
            android:textColor="#FBBF24"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_rpg_dust"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="尘埃: 120"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_rpg_diag_log"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="日志"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Full-page scrollable body so header controls never crush content in landscape -->
    <ScrollView
        android:id="@+id/scroll_rpg_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Timeline header block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E293B"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="10dp">

                <!-- Timeline Controls: wide progress text on left, stacked action buttons on right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_timeline_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="当前时间轴: 1999-02-04"
                        android:textColor="#CBD5E1"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btn_pick_date"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:backgroundTint="#334155"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="📅 移动时间点"
                            android:textColor="#F8FAFC"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_timeline_digest"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#0284C7"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="📰 当期动态"
                            android:textColor="#F8FAFC"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_active_banlist"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#991B1B"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="🚫 当期禁限表"
                            android:textColor="#F8FAFC"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Compact Timeline Stepper: [◀ 上一时间点] [当前时间点] [下一时间点 ▶] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_prev_milestone"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#334155"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="◀ 上一节点"
                        android:textColor="#F8FAFC"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tv_current_milestone"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="#0F172A"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:text="📅 1999-02-04"
                        android:textColor="#FBBF24"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_next_milestone"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#334155"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="下一节点 ▶"
                        android:textColor="#F8FAFC"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_timeline_digest_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#0F172A"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="📰 1999-02-04：点击查看当前时间点大事件详情"
                    android:textColor="#FDE68A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_active_banlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="生效禁限表: 1999.02.04 OCG 创世环境（无禁限）"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_active_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="生效规则: 1999.02.04 初代官方规则（随时间轴自动锁定）"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Draggable Reorderable Tabs (long-press and drag to reorder) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rpg_nav_tabs"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#1E293B"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155" />

            <!-- Action Bar for current tab -->
            <LinearLayout
                android:id="@+id/layout_tab_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F172A"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />

            <!-- Tab content -->
            <LinearLayout
                android:id="@+id/layout_rpg_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
